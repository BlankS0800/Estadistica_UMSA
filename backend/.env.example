# Base de datos PostgreSQL (en Docker cambiar localhost:5433 por postgres:5432)
DATABASE_URL="postgresql://postgres:123@localhost:5433/usuarios"

# Clave secreta para firmar tokens JWT
SECRET="cambia_esta_clave_en_produccion"

# Puerto HTTP del servidor NestJS
PORT=3000

# Directorio de archivos subidos (montar como volumen persistente en Docker)
UPLOAD_DIR="./uploads"

# Orígenes permitidos por CORS separados por coma (vacío = permitir todos)
# CORS_ORIGIN="https://estadistica.umsa.bo"
