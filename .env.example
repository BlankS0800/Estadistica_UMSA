# Configuración general para Docker Compose (copia este archivo a .env en producción)

# Base de datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_contrasena_segura
POSTGRES_DB=usuarios
POSTGRES_PORT=5433

# Clave secreta para firmar JWT (usa al menos 64 caracteres aleatorios en producción)
JWT_SECRET=reemplaza_esto_por_una_clave_aleatoria_muy_larga_en_produccion

# Puerto donde se expondrá el portal web (en servidor final suele ser 80 o un puerto interno detrás de proxy SSL)
FRONTEND_PORT=8080

# Orígenes permitidos por CORS separados por coma (vacío permite el mismo origen vía Nginx)
CORS_ORIGIN=
